# Configuration de la base de données
DATABASE_URL="mysql://username:password@localhost:3306/patnuc_segmentation"

# Configuration JWT
JWT_SECRET=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# Configuration JWT avec clés RSA (RS256) - Pour intégration Symfony
# Pour utiliser les clés RSA Symfony, décommentez et configurez ces variables :
# JWT_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PRIVATE_KEY_PASSPHRASE=votre-passphrase-si-necessaire
# 
# Alternative: Utiliser des fichiers de clés (recommandé)
# JWT_PRIVATE_KEY_PATH=./jwt-symfony-private.pem
# JWT_PUBLIC_KEY_PATH=./jwt-symfony-public.pem
# JWT_PRIVATE_KEY_PASSPHRASE=votre-passphrase-si-necessaire

# Configuration Email (si utilisé)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password

# Configuration SMS (Devcode SMS API)
