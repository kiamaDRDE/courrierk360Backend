# Auto detect text files and perform LF normalization
* text=auto

# Force LF for specific files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.env text eol=lf
.env.example text eol=lf

# Force CRLF for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
