# Configuration pour utiliser les clés JWT Symfony (RS256)
# 
# Les clés sont stockées dans les fichiers jwt-symfony-private.pem et jwt-symfony-public.pem
# à la racine du projet.

# Chemin vers la clé privée (pour signer les tokens - optionnel si vous utilisez uniquement la validation)
JWT_PRIVATE_KEY_PATH=./jwt-symfony-private.pem

# Chemin vers la clé publique (pour valider les tokens)
JWT_PUBLIC_KEY_PATH=./jwt-symfony-public.pem

# Passphrase de la clé privée (laissez vide si vous ne connaissez pas le mot de passe)
# La clé privée Symfony est chiffrée, mais pour la validation (JWT_PUBLIC_KEY), 
# aucun mot de passe n'est nécessaire.
JWT_PRIVATE_KEY_PASSPHRASE=

# Note: Si JWT_PRIVATE_KEY_PASSPHRASE est requis pour signer de nouveaux tokens,
# vous devrez obtenir le mot de passe depuis l'équipe Symfony.
# Pour VALIDER les tokens Symfony existants, seule la clé publique est nécessaire.

# Configuration JWT de secours (HS256) - pour compatibilité
JWT_SECRET=patnuc-segmentation-secret-key-2025
JWT_REFRESH_SECRET=patnuc-segmentation-refresh-secret-key-2025
