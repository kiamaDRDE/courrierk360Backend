generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement()) @map("id")

  username         String    @unique @map("username") @db.VarChar(255)
  firstName        String?   @map("first_name") @db.VarChar(255)
  lastName         String?   @map("last_name") @db.VarChar(255)
  email            String    @unique @map("email") @db.VarChar(191)
  phone            String?   @map("phone") @db.VarChar(50)
  numero           String    @map("numero") @db.VarChar(100)

  civilite         String?   @map("civilite") @db.VarChar(50)
  avatar           String?   @map("avatar") @db.VarChar(500)

  password         String    @map("password") @db.VarChar(255)

  isSignataire     Boolean   @default(false) @map("is_signataire")
  isActive         Boolean   @default(true) @map("is_active")
  isDelete         Boolean   @default(false) @map("is_delete")
  langue           Boolean   @default(true) @map("langue")

  resetOtp         String?   @map("reset_otp") @db.VarChar(255)
  resetExpires     DateTime? @map("reset_expires")
  token            String?   @map("token") @db.VarChar(500)
  expiresToken     DateTime? @map("expires_token")
  refreshToken     String?   @map("refresh_token") @db.VarChar(500)
  refreshExpires   DateTime? @map("refresh_expires")
  verifyOtp        String?   @map("verify_otp") @db.VarChar(255)
  verifyExpires    DateTime? @map("verify_expires")

  idCorrespondant  Int?      @map("id_correspondant")
  idService        Int?      @map("id_service")
  idRole           Int?      @map("id_role")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  // relations
  activityLogs           ActivityLog[]
  correspondant          Correspondant?            @relation("UserCorrespondant", fields: [idCorrespondant], references: [id], onDelete: SetNull)
  service                Service?                  @relation("UserService", fields: [idService], references: [id], onDelete: SetNull)
  role                   Role?                     @relation("UserRole", fields: [idRole], references: [id], onDelete: SetNull)
  servicesAdditionnels   UserServiceAdditionnel[]
  notifications          Notification[]            @relation("NotificationUser")
  courriers              Courrier[]                @relation("CourrierUser")
  reponses               Reponse[]                 @relation("ReponseRedacteur")
  transmissions          Transmission[]            @relation("TransmissionEmetteur")

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([numero])
  @@index([isActive])
  @@index([isDelete])
  @@index([idCorrespondant])
  @@index([idService])
  @@index([idRole])
  @@map("users")
}


model ActivityLog {
  id          Int      @id @default(autoincrement()) @map("id")
  userId      Int?     @map("user_id") // Optionnel pour les actions système
  action      String   @map("action") @db.VarChar(255)
  module      String   @default("SYSTEM") @map("module") @db.VarChar(100)
  level       String   @default("INFO") @map("level") @db.VarChar(50) // INFO, WARNING, ERROR, SUCCESS
  description String?  @map("description") @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  metadata    Json?    @map("metadata") // Métadonnées au format JSON
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([module])
  @@index([level])
  @@map("activity_logs")
}


model Categories {
  id        Int      @id @default(autoincrement()) @map("id")
  nom       String   @unique @map("nom") @db.VarChar(255)
  isDelete  Boolean  @default(false) @map("is_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  correspondants CategoriesCorrespondant[]

  @@index([nom])
  @@index([isDelete])
  @@index([createdAt])
  @@map("categories")
}

model Correspondant {
  id        Int      @id @default(autoincrement()) @map("id")
  nom       String   @map("nom") @db.VarChar(255)
  adresse   String?  @map("adresse") @db.VarChar(255)
  telephone String   @map("telephone") @db.VarChar(50)
  email     String?  @map("email") @db.VarChar(191)
  type      String   @map("type") @db.VarChar(100)
  civilite  String?  @map("civilite") @db.VarChar(50)
  matricule String?  @map("matricule") @db.VarChar(100)
  isDelete  Boolean  @default(false) @map("is_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  categories      CategoriesCorrespondant[]
  courriers       Courrier[]               @relation("CourrierProvenance")
  courrierDeparts CourrierDepart[]         @relation("CourrierDepartDestinataire")
  users           User[]                   @relation("UserCorrespondant")

  @@index([nom])
  @@index([telephone])
  @@index([email])
  @@index([type])
  @@index([matricule])
  @@index([isDelete])
  @@index([createdAt])
  @@map("correspondant")
}

model TypeCourrier {
  id             Int            @id @default(autoincrement()) @map("id")
  nom            String         @unique @map("nom") @db.VarChar(255)
  type           String         @map("type") @db.VarChar(100)
  classeCourrier String?        @map("classe_courrier") @db.VarChar(100)
  isDelete       Boolean        @default(false) @map("is_delete")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  //relation
  courriers      Courrier[]     @relation("CourrierTypeCourrier")

  @@index([nom])
  @@index([type])
  @@index([classeCourrier])
  @@index([isDelete])
  @@index([createdAt])
  @@map("type_courrier")
}


model ClasseCourrier {
  id        Int      @id @default(autoincrement()) @map("id")
  nom       String   @unique @map("nom") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("classe_courrier")

}


model Role {
  id          Int      @id @default(autoincrement()) @map("id")
  nom         String   @unique @map("nom") @db.VarChar(255)
  description String?  @map("description") @db.Text
  isDelete    Boolean  @default(false) @map("is_delete")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  permissions RolePermission[]
  users       User[]             @relation("UserRole")

  @@index([nom])
  @@index([isDelete])
  @@index([createdAt])
  @@map("role")
}


model Permission {
  id          Int      @id @default(autoincrement()) @map("id")
  nom         String   @unique @map("nom") @db.VarChar(255)
  description String?  @map("description") @db.Text
  isDelete    Boolean  @default(false) @map("is_delete")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  roles       RolePermission[]

  @@index([nom])
  @@index([isDelete])
  @@index([createdAt])
  @@map("permission")
}


model Service {
  id        Int      @id @default(autoincrement()) @map("id")

  nom       String   @unique @map("nom") @db.VarChar(255)
  sigle     String?  @map("sigle") @db.VarChar(50)
  type      String?  @map("type") @db.VarChar(50)

  parentId  Int?     @map("id_service_parent")
  parent    Service?  @relation("ServiceParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Service[] @relation("ServiceParent")

  isActive  Boolean  @default(true) @map("is_active")
  isDelete  Boolean  @default(false) @map("is_delete")
  isVisible Boolean  @default(true) @map("is_visible_in_transmission")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  users                  User[]                   @relation("UserService")
  servicesAdditionnels   UserServiceAdditionnel[]
  courriers              Courrier[]               @relation("CourrierService")
  transmissions          Transmission[]           @relation("TransmissionService")
  reponses               Reponse[]                @relation("ReponseService")
  reponsesDestinataire   Reponse[]                @relation("ReponseServiceDestinataire")
  notifications          Notification[]           @relation("NotificationService")

  @@index([sigle])
  @@index([parentId])
  @@index([isActive])
  @@index([isDelete])
  @@index([isVisible])
  @@index([createdAt])
  @@map("service")
}


model Salle {
  id        Int      @id @default(autoincrement()) @map("id")

  nom       String   @unique @map("nom") @db.VarChar(255)

  isActive  Boolean  @default(true) @map("is_active")
  isDelete  Boolean  @default(false) @map("is_delete")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  coffres   Coffre[]

  @@index([isActive])
  @@index([isDelete])
  @@index([createdAt])
  @@map("salle")
}


model Coffre {
  id                 Int      @id @default(autoincrement()) @map("id")
  nom                String   @unique @map("nom") @db.VarChar(255)
  nombrePlaceActuelle Int     @default(0) @map("nombre_place_actuelle")
  tailleMaximale     Int      @default(20)@map("taille_maximale")
  idSalle            Int      @map("id_salle")

  isActive           Boolean  @default(true) @map("is_active")
  isDelete           Boolean  @default(false) @map("is_delete")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  //relation
  salle              Salle    @relation(fields: [idSalle], references: [id], onDelete: Cascade)

  @@index([idSalle])
  @@index([isActive])
  @@index([isDelete])
  @@index([createdAt])
  @@map("coffre")
}

model Notification {
  id        Int       @id @default(autoincrement()) @map("id")
  titre     String    @map("titre") @db.VarChar(255)
  message   String?   @map("message") @db.Text
  type      String    @map("type") @db.VarChar(100)
  idUser    Int?      @map("id_user")
  idService Int?      @map("id_service")

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  isDelete  Boolean   @default(false) @map("is_delete")

  data      Json?     @map("data") // métadonnées ou payload JSON

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  user      User?     @relation("NotificationUser", fields: [idUser], references: [id], onDelete: Cascade)
  service   Service?  @relation("NotificationService", fields: [idService], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([idUser])
  @@index([idService])
  @@index([isRead])
  @@index([readAt])
  @@index([isDelete])
  @@index([createdAt])
  @@map("notifications")
}

model Archive {
  id                  Int      @id @default(autoincrement()) @map("id")
  idCourrier          Json     @map("id_courrier")
  idTransmission      Json     @map("id_transmission")
  idCourrierDepart    Json     @map("id_courrier_depart")
  fichier             String    @map("fichier") @db.VarChar(100)

  idSalle             Int      @map("id_salle")
  idCoffre            Int      @map("id_coffre")

  isDelete            Boolean  @default(false) @map("is_delete")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([idSalle])
  @@index([idCoffre])
  @@index([isDelete])
  @@index([createdAt])
  @@map("archive")
}


model BordereauTransmission {
  id                Int       @id @default(autoincrement()) @map("id")
  courrierIds       Json      @map("courrier_ids")
  correspondantId   Int       @map("correspondant_id")
  numeroReference   String?   @map("numero_reference") @db.VarChar(255)
  nombrePieceJointe Int?      @map("nombre_piece_jointe")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([correspondantId])
  @@index([numeroReference])
  @@index([createdAt])
  @@map("bordereau_transmission")
}


model Courrier {
  id                  Int       @id @default(autoincrement()) @map("id")
  numero              String    @unique @map("numero") @db.VarChar(255)
  reference           String?   @map("reference") @db.VarChar(255)
  objet               String?   @map("objet") @db.VarChar(255)
  idProvenance        Int?      @map("id_provenance")
  idTypeCourrier      Int?      @map("id_type_courrier")
  idService           Int?      @map("id_service")
  idUser              Int?      @map("id_user")
  commentaire         String?   @map("commentaire") @db.Text
  commentairePublic   String?   @map("commentaire_public") @db.Text
  commentaireInterne  String?   @map("commentaire_interne") @db.Text
  priorite            String?   @map("priorite") @db.VarChar(50)
  isConfidentiel      Boolean   @default(false) @map("is_confidentiel")
  dateArrivee         DateTime? @default(now()) @map("date_arrivee")
  dateEnregistrement  DateTime? @default(now()) @map("date_enregistrement")
  statut              String?   @map("statut") @db.VarChar(100)
  isGeled             Boolean   @default(false) @map("is_geled")
  document            String?   @map("document") @db.VarChar(100)
  bordereauRemise     Json?     @map("bordereau_remise")
  dateRemiseEffective DateTime? @default(now()) @map("date_remise_effective")
  dateCloture         DateTime? @map("date_cloture")
  telephone           String?   @map("telephone") @db.VarChar(50)
  email               String?   @map("email") @db.VarChar(191)
  adresse             String?   @map("adresse") @db.VarChar(255)
  civilite            String?   @map("civilite") @db.VarChar(50)
  nom                 String?   @map("nom") @db.VarChar(255)
  matricule           String?   @map("matricule") @db.VarChar(100)
  typeTransfert       String?   @map("type_transfert") @db.VarChar(100)
  classeCourrier      String?   @map("classe_courrier") @db.VarChar(100)
  categorie           String?   @map("categorie") @db.VarChar(100)
  isDelete            Boolean   @default(false) @map("is_delete")
  isArchive           Boolean   @default(false) @map("is_archive")
  statutArchive       String?   @map("statut_archive") @db.VarChar(100)
  viderPar            Json?     @map("vider_par")
  nombrePieceJointe   Int?      @map("nombre_piece_jointe")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  provenance          Correspondant? @relation("CourrierProvenance", fields: [idProvenance], references: [id], onDelete: SetNull)
  typeCourrier        TypeCourrier?  @relation("CourrierTypeCourrier", fields: [idTypeCourrier], references: [id], onDelete: SetNull)
  service             Service?       @relation("CourrierService", fields: [idService], references: [id], onDelete: SetNull)
  user                User?          @relation("CourrierUser", fields: [idUser], references: [id], onDelete: SetNull)
  transmissions       Transmission[] @relation("CourrierTransmission")
  courrierDeparts     CourrierDepart[] @relation("CourrierDepartCourrier")
  reponses            CourrierReponse[]
  piecesJointes       PieceJointe[] @relation("CourrierPieceJointe")

  @@index([reference])
  @@index([idProvenance])
  @@index([idTypeCourrier])
  @@index([idService])
  @@index([idUser])
  @@index([priorite])
  @@index([statut])
  @@index([dateArrivee])
  @@index([dateEnregistrement])
  @@index([isDelete])
  @@index([isArchive])
  @@map("courrier")
}


model CourrierDepart {
  id                Int       @id @default(autoincrement()) @map("id")
  typeCourrier      String?   @map("type_courrier") @db.VarChar(100)
  commentaire       String?   @map("commentaire") @db.Text
  objet             String?   @map("objet") @db.Text
  numeroReference   String?   @map("numero_reference") @db.VarChar(255)
  idDestinataire    Int?      @map("id_destinataire")
  idCourrier        Int?      @map("id_courrier")
  document          String?   @map("document") @db.Text
  numeroActe        String?   @map("numero_acte") @db.VarChar(100)
  provenancesCopie  Json?     @map("provenances_copie")
  idProjet          Int?      @map("id_projet")
  isDelete          Boolean   @default(false) @map("is_delete")
  isArchive         Boolean   @default(false) @map("is_archive")
  statutArchive     String?   @map("statut_archive") @db.VarChar(100)
  viderPar          Json?     @map("vider_par")
  nombrePieceJointe Int?      @map("nombre_piece_jointe")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  destinataire      Correspondant? @relation("CourrierDepartDestinataire", fields: [idDestinataire], references: [id], onDelete: SetNull)
  courrier          Courrier?      @relation("CourrierDepartCourrier", fields: [idCourrier], references: [id], onDelete: SetNull)
  projet            Projet?        @relation(fields: [idProjet], references: [id], onDelete: SetNull)
  piecesJointes     PieceJointe[]  @relation("CourrierDepartPieceJointe")

  @@index([typeCourrier])
  @@index([idDestinataire])
  @@index([idCourrier])
  @@index([numeroReference])
  @@index([idProjet])
  @@index([isDelete])
  @@index([isArchive])
  @@index([createdAt])
  @@map("courrier_depart")
}


model PieceJointe {
  id         Int       @id @default(autoincrement()) @map("id")
  nom        String?   @map("nom") @db.VarChar(255)
  intitule   String?   @map("intitule") @db.VarChar(255)
  chemin     String    @map("chemin") @db.VarChar(500)
  type           String?   @map("type") @db.VarChar(100)
  idParent       Int?      @map("id_parent")
  typeParent     String?   @map("type_parent") @db.VarChar(100)
  idTransmission Int?      @map("id_transmission")
  idCourrier     Int?      @map("id_courrier")
  idCourrierDepart Int?    @map("id_courrier_depart")
  idReponse      Int?      @map("id_reponse")
  isDelete       Boolean   @default(false) @map("is_delete")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  transmission   Transmission? @relation("TransmissionPieceJointe", fields: [idTransmission], references: [id], onDelete: Cascade)
  courrier       Courrier? @relation("CourrierPieceJointe", fields: [idCourrier], references: [id], onDelete: Cascade)
  courrierDepart CourrierDepart? @relation("CourrierDepartPieceJointe", fields: [idCourrierDepart], references: [id], onDelete: Cascade)
  reponse        Reponse?  @relation("ReponsePieceJointe", fields: [idReponse], references: [id], onDelete: Cascade)

  @@index([idParent])
  @@index([idTransmission])
  @@index([idCourrier])
  @@index([idCourrierDepart])
  @@index([idReponse])
  @@index([typeParent])
  @@index([type])
  @@index([isDelete])
  @@index([createdAt])
  @@map("piece_jointe")
}


model Reponse {
  id                Int       @id @default(autoincrement()) @map("id")
  typesCourrierIds  Json      @map("types_courrier_ids")
  idTransmission    Json      @map("id_transmission")
  objet             String?   @map("objet") @db.VarChar(255)
  idService         Int?      @map("id_service")
  idServiceDestinataire Int?  @map("id_service_destinataire")
  idRedacteur       Int?      @map("id_redacteur")
  commentairePublic String?   @map("commentaire_public") @db.Text
  commentaireInterne String?  @map("commentaire_interne") @db.Text
  dateReponse       DateTime? @default(now()) @map("date_reponse")
  classeCourrier    String?   @map("classe_courrier") @db.VarChar(100)
  typeTransmission  String?   @map("type_transmission") @db.VarChar(100)
  isDelete          Boolean   @default(false) @map("is_delete")
  nombrePieceJointe Int?      @map("nombre_piece_jointe")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  service                Service?  @relation("ReponseService", fields: [idService], references: [id], onDelete: SetNull)
  serviceDestinataire    Service?  @relation("ReponseServiceDestinataire", fields: [idServiceDestinataire], references: [id], onDelete: SetNull)
  redacteur              User?     @relation("ReponseRedacteur", fields: [idRedacteur], references: [id], onDelete: SetNull)
  courriers              CourrierReponse[]
  piecesJointes          PieceJointe[] @relation("ReponsePieceJointe")

  @@index([dateReponse])
  @@index([idService])
  @@index([idServiceDestinataire])
  @@index([idRedacteur])
  @@index([classeCourrier])
  @@index([typeTransmission])
  @@index([isDelete])
  @@index([createdAt])
  @@map("reponse")
}


model Transmission {
  id                Int       @id @default(autoincrement()) @map("id")
  structuresCopie   Json?     @map("structures_copie")
  dateInstruction   DateTime? @default(now()) @map("date_instruction")
  dateReception     DateTime? @default(now()) @map("date_reception")
  instruction       String?   @map("instruction") @db.Text
  commentairePublic String?   @map("commentaire_public") @db.Text
  commentaireInterne String?  @map("commentaire_interne") @db.Text
  delaiTraitement   Int?      @map("delai_traitement")
  typeTransfert     String?   @map("type_transfert") @db.VarChar(100)
  idService         Int?      @map("id_service")
  idCourrier        Int?      @map("id_courrier")
  idEmetteur        Int?      @map("id_emetteur")
  accuseReception   Boolean?  @map("accuse_reception")
  traitePar         Json?     @map("traite_par")
  statut            String?   @map("statut") @db.VarChar(100)
  document          String?   @map("document") @db.VarChar(255)
  pieceJointe       Json?     @map("piece_jointe")
  isDelete          Boolean   @default(false) @map("is_delete")
  isArchive         Boolean   @default(false) @map("is_archive")
  isGeled             Boolean   @default(false) @map("is_geled")
  isinstance        Boolean   @default(false) @map("isinstance")
  statutArchive     String?   @map("statut_archive") @db.VarChar(100)
  viderPar          Json?     @map("vider_par")
  nombrePieceJointe Int?      @map("nombre_piece_jointe")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  //relation
  service           Service?  @relation("TransmissionService", fields: [idService], references: [id], onDelete: SetNull)
  courrier          Courrier? @relation("CourrierTransmission", fields: [idCourrier], references: [id], onDelete: SetNull)
  emetteur          User?     @relation("TransmissionEmetteur", fields: [idEmetteur], references: [id], onDelete: SetNull)
  piecesJointes     PieceJointe[] @relation("TransmissionPieceJointe")

  @@index([dateInstruction])
  @@index([dateReception])
  @@index([typeTransfert])
  @@index([idService])
  @@index([idCourrier])
  @@index([idEmetteur])
  @@index([statut])
  @@index([isDelete])
  @@index([isArchive])
  @@index([createdAt])
  @@map("transmission")
}

// Table de jonction pour la relation many-to-many entre Categories et Correspondant
model CategoriesCorrespondant {
  id              Int           @id @default(autoincrement()) @map("id")
  categorieId     Int           @map("categorie_id")
  correspondantId Int           @map("correspondant_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  categorie       Categories    @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  correspondant   Correspondant @relation(fields: [correspondantId], references: [id], onDelete: Cascade)

  @@unique([categorieId, correspondantId])
  @@index([categorieId])
  @@index([correspondantId])
  @@map("categories_correspondant")
}

// Table de jonction pour les services additionnels des utilisateurs
model UserServiceAdditionnel {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    Int      @map("user_id")
  serviceId Int      @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
  @@map("user_service_additionnel")
}

// Table de jonction pour la relation many-to-many entre Courrier et Reponse
model CourrierReponse {
  id        Int      @id @default(autoincrement()) @map("id")
  courrierId Int     @map("courrier_id")
  reponseId Int      @map("reponse_id")
  createdAt DateTime @default(now()) @map("created_at")

  courrier  Courrier @relation(fields: [courrierId], references: [id], onDelete: Cascade)
  reponse   Reponse  @relation(fields: [reponseId], references: [id], onDelete: Cascade)

  @@unique([courrierId, reponseId])
  @@index([courrierId])
  @@index([reponseId])
  @@map("courrier_reponse")
}

// Table de jonction pour la relation many-to-many entre Role et Permission
model RolePermission {
  id           Int        @id @default(autoincrement()) @map("id")
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permission")
}


model Projet {
  id        Int      @id @default(autoincrement()) @map("id")
  name      String   @map("name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  // relations
  courriersDeparts CourrierDepart[]

  @@index([name])
  @@index([createdAt])
  @@map("projet")
}

