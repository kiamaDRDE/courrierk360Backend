// Modèles pour les consommations moyennes
model ConsommationMoyenne {
  id        Int      @id @default(autoincrement()) @map("id")
  nom       String   @map("nom") @db.VarChar(255)
  valeur    Float    @map("valeur")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations Many-to-Many avec les offres et options
  offres    OffreConsommationMoyenne[]
  options   OptionConsommationMoyenne[]

  @@index([nom])
  @@map("consommations_moyennes")
}

model OffreConsommationMoyenne {
  id                     Int                  @id @default(autoincrement()) @map("id")
  offreId                Int                  @map("offre_id")
  consommationMoyenneId  Int                  @map("consommation_moyenne_id")
  createdAt              DateTime             @default(now()) @map("created_at")

  // Relations
  offre                  Offre                @relation(fields: [offreId], references: [id], onDelete: Cascade)
  consommationMoyenne    ConsommationMoyenne  @relation(fields: [consommationMoyenneId], references: [id], onDelete: Cascade)

  @@unique([offreId, consommationMoyenneId], name: "unique_offre_consommation_moyenne")
  @@index([offreId])
  @@index([consommationMoyenneId])
  @@map("offre_consommations_moyennes")
}

// Modèles pour les options
model Option {
  id                     Int      @id @default(autoincrement()) @map("id")
  offreId                Int      @map("offre_id")
  nom                    String   @map("nom") @db.VarChar(255)
  tva                    Decimal  @map("tva") @db.Decimal(5, 2)
  nombreSouscriptions    Int      @map("nombre_souscriptions")
  traficOption Decimal?  @map("trafic_option") @db.Decimal(10, 2)
  fraisSouscription      Decimal  @map("frais_souscription") @db.Decimal(10, 2)
  tarifMinuteOnNet       Decimal  @map("tarif_minute_on_net") @db.Decimal(10, 2)
  tarifMinuteOffNet      Decimal  @map("tarif_minute_off_net") @db.Decimal(10, 2)
  annee                  Int      @map("annee")
  trafic                 Decimal  @default(0) @map("trafic") @db.Decimal(15, 2)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  offre                  Offre    @relation(fields: [offreId], references: [id], onDelete: Cascade)
  structuresTarifaires   OptionStructureTarifaire[]
  avantages              OptionAvantage[]
  consommationsMoyennes  OptionConsommationMoyenne[]

  @@index([id])
  @@index([offreId])
  @@index([nom])
  @@index([annee])
  @@map("options")
}

model StructureTarifaire {
  id             Int      @id @default(autoincrement()) @map("id")
  nom            String   @map("nom") @db.VarChar(255)
  valeur         Decimal  @map("valeur") @db.Decimal(10, 2)
  estObligatoire Boolean  @default(false) @map("est_obligatoire")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations avec les options
  options   OptionStructureTarifaire[]

  @@index([nom])
  @@map("structures_tarifaires")
}

model OptionStructureTarifaire {
  id                    Int                @id @default(autoincrement()) @map("id")
  optionId              Int                @map("option_id")
  structureTarifaireId  Int                @map("structure_tarifaire_id")
  valeur         Decimal?  @map("valeur") @db.Decimal(10, 2)
  createdAt             DateTime           @default(now()) @map("created_at")

  // Relations
  option                Option             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  structureTarifaire    StructureTarifaire @relation(fields: [structureTarifaireId], references: [id], onDelete: Cascade)

  @@unique([optionId, structureTarifaireId], name: "unique_option_structure_tarifaire")
  @@index([optionId])
  @@index([structureTarifaireId])
  @@map("option_structures_tarifaires")
}

model OptionAvantage {
  id          Int      @id @default(autoincrement()) @map("id")
  optionId    Int      @map("option_id")
  avantageId  Int      @map("avantage_id")
  valeur         Decimal?  @map("valeur") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  option      Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  avantage    Avantage @relation(fields: [avantageId], references: [id], onDelete: Cascade)

  @@unique([optionId, avantageId], name: "unique_option_avantage")
  @@index([optionId])
  @@index([avantageId])
  @@map("option_avantages")
}

model OptionConsommationMoyenne {
  id                     Int                  @id @default(autoincrement()) @map("id")
  optionId               Int                  @map("option_id")
  consommationMoyenneId  Int                  @map("consommation_moyenne_id")
  valeur         Decimal?  @map("valeur") @db.Decimal(10, 2)
  createdAt              DateTime             @default(now()) @map("created_at")

  // Relations
  option                 Option               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  consommationMoyenne    ConsommationMoyenne  @relation(fields: [consommationMoyenneId], references: [id], onDelete: Cascade)

  @@unique([optionId, consommationMoyenneId], name: "unique_option_consommation_moyenne")
  @@index([optionId])
  @@index([consommationMoyenneId])
  @@map("option_consommations_moyennes")
}

model CiseauTarifaire {
  id                  Int      @id @default(autoincrement()) @map("id")
  annee               Int      @unique @map("annee")
  coutReseau          Decimal  @default(0) @map("cout_reseau") @db.Decimal(18, 2)
