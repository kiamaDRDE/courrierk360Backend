generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int           @id @default(autoincrement()) @map("id")
  nom            String        @map("nom") @db.VarChar(255)
  email          String        @unique @map("email") @db.VarChar(191)
  numero         String        @map("numero")
  fonction       String?       @map("fonction") @db.VarChar(255)
  password       String        @map("password") @db.VarChar(255)
  role           UserRole      @default(SUPER_ADMIN) @map("role")
  resetOtp       String?       @map("reset_otp") @db.VarChar(255)
  resetExpires   DateTime?     @map("reset_expires")
  token          String?       @map("token") @db.VarChar(500)
  expiresToken   DateTime?     @map("expires_token")
  refreshToken   String?       @map("refresh_token") @db.VarChar(500)
  refreshExpires DateTime?     @map("refresh_expires")
  verifyOtp      String?       @map("verify_otp") @db.VarChar(255)
  verifyExpires  DateTime?     @map("verify_expires")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  activityLogs   ActivityLog[]

  @@index([id])
  @@index([email])
  @@index([numero])
  @@map("users")
}

model ActivityLog {
  id          Int      @id @default(autoincrement()) @map("id")
  userId      Int?     @map("user_id") // Optionnel pour les actions système
  action      String   @map("action") @db.VarChar(255)
  module      String   @default("SYSTEM") @map("module") @db.VarChar(100)
  level       String   @default("INFO") @map("level") @db.VarChar(50) // INFO, WARNING, ERROR, SUCCESS
  description String?  @map("description") @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  metadata    Json?    @map("metadata") // Métadonnées au format JSON
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([module])
  @@index([level])
  @@map("activity_logs")
}

model Operateur {
  id              Int      @id @default(autoincrement()) @map("id")
  nom             String   @unique @map("nom") @db.VarChar(191)
  code            String   @map("code") @db.VarChar(50)
  description     String?  @map("description") @db.Text
  type            String   @map("type") @db.VarChar(100)
  statut          String   @map("statut") @db.VarChar(50)
  anneeCreation   Int?     @map("annee_creation")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  offres                  Offre[]
  tarifsInterconnexion    TarifInterconnexion[]
  services                OperateurService[]
  // Relations pour le trafic
  trafics                 Trafic[]
  traficAutresOperateurs  TraficAutreOperateur[]
  // Relations pour les abonnements
  abonnements             Abonnement[]
  // Relations pour les chiffres d'affaire
  chiffresAffaire         ChiffreAffaire[]
  // Relations pour les parts de marché
  partsMarche             PartMarche[]

  @@index([id])
  @@index([nom])
  @@index([code])
  @@index([statut])
  @@map("operateurs")
}

model Service {
  id          Int      @id @default(autoincrement()) @map("id")
  nom         String   @unique @map("nom") @db.VarChar(191)
  description String?  @map("description") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  operateurs  OperateurService[]
  tarifs      TarifInterconnexionService[]
  offres      OffreService[]
  // Relations pour le trafic
  traficServices TraficService[]
  // Relations pour les abonnements
  abonnementServices AbonnementService[]
  // Relations pour les chiffres d'affaire
  chiffreAffaireServices ChiffreAffaireService[]

  @@index([id])
  @@index([nom])
  @@map("services")
}

model OperateurService {
  id          Int       @id @default(autoincrement()) @map("id")
  operateurId Int       @map("operateur_id")
  serviceId   Int       @map("service_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  operateur   Operateur @relation(fields: [operateurId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([operateurId, serviceId], name: "unique_operateur_service")
  @@index([operateurId])
  @@index([serviceId])
  @@map("operateur_services")
}

model TypeAppel {
  id          Int      @id @default(autoincrement()) @map("id")
  libelle     String   @unique @map("libelle") @db.VarChar(191)
  description String?  @map("description") @db.Text
  categorie   String   @map("categorie") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([id])
  @@index([libelle])
  @@index([categorie])
  @@map("type_appels")
}

model Offre {
  id                Int       @id @default(autoincrement()) @map("id")
  operateurId       Int       @map("operateur_id")
  nom               String    @map("nom") @db.VarChar(191)
  dateDebutValidite DateTime  @map("date_debut_validite")
  dateFinValidite   DateTime  @map("date_fin_validite")
  typeOffre         String    @map("type_offre") @db.VarChar(100)
  destination       String    @map("destination") @db.VarChar(255)
  statut            String    @map("statut") @db.VarChar(50)
  description       String?   @map("description") @db.Text

  // Nouveaux champs tarifaires OnNet et OffNet
  tp           Decimal?  @default(0) @map("tp") @db.Decimal(10, 2)
  tnc          Decimal?  @default(0) @map("tnc") @db.Decimal(10, 2)
  ep           Decimal?  @default(0) @map("ep") @db.Decimal(10, 2)
  
  // Nouveaux champs tarifaires OnNet et OffNet
  tpOnNet           Decimal?  @default(0) @map("tp_onnet") @db.Decimal(10, 2)
  tfOnNet           Decimal?  @default(0) @map("tf_onnet") @db.Decimal(10, 2)
  tncOnNet          Decimal?  @default(0) @map("tnc_onnet") @db.Decimal(10, 2)
  epOnNet           Decimal?  @default(0) @map("ep_onnet") @db.Decimal(10, 2)
  tpOffNet          Decimal?  @default(0) @map("tp_offnet") @db.Decimal(10, 2)
  tfOffNet          Decimal?  @default(0) @map("tf_offnet") @db.Decimal(10, 2)
  tncOffNet         Decimal?  @default(0) @map("tnc_offnet") @db.Decimal(10, 2)
  epOffNet          Decimal?  @default(0) @map("ep_offnet") @db.Decimal(10, 2)
  
  // Champs calculés pour l'effet club
  taBaseOperateurOffnetHC      Decimal?  @default(0) @map("ta_base_operateur_offnet_hc") @db.Decimal(10, 2)
  taBaseOperateurOffnetHP      Decimal?  @default(0) @map("ta_base_operateur_offnet_hp") @db.Decimal(10, 2)
  taBaseOperateurOnnetHC       Decimal?  @default(0) @map("ta_base_operateur_onnet_hc") @db.Decimal(10, 2)
  taBaseOperateurOnnetHP       Decimal?  @default(0) @map("ta_base_operateur_onnet_hp") @db.Decimal(10, 2)
  taInterOperateurOffnetHC     Decimal?  @default(0) @map("ta_inter_operateur_offnet_hc") @db.Decimal(10, 2)
  taInterOperateurOffnetHP     Decimal?  @default(0) @map("ta_inter_operateur_offnet_hp") @db.Decimal(10, 2)
  taInterOperateurOnnetHC      Decimal?  @default(0) @map("ta_inter_operateur_onnet_hc") @db.Decimal(10, 2)
  taInterOperateurOnnetHP      Decimal?  @default(0) @map("ta_inter_operateur_onnet_hp") @db.Decimal(10, 2)
  sommeBaseAutresOperateursOffnetHC    Decimal?  @default(0) @map("somme_base_autres_operateurs_offnet_hc") @db.Decimal(15, 2)
  sommeBaseAutresOperateursOffnetHP    Decimal?  @default(0) @map("somme_base_autres_operateurs_offnet_hp") @db.Decimal(15, 2)
  sommeBaseAutresOperateursOnnetHC     Decimal?  @default(0) @map("somme_base_autres_operateurs_onnet_hc") @db.Decimal(15, 2)
  sommeBaseAutresOperateursOnnetHP     Decimal?  @default(0) @map("somme_base_autres_operateurs_onnet_hp") @db.Decimal(15, 2)
  sommeInterAutresOperateursOffnetHC   Decimal?  @default(0) @map("somme_inter_autres_operateurs_offnet_hc") @db.Decimal(15, 2)
  sommeInterAutresOperateursOffnetHP   Decimal?  @default(0) @map("somme_inter_autres_operateurs_offnet_hp") @db.Decimal(15, 2)
  sommeInterAutresOperateursOnnetHC    Decimal?  @default(0) @map("somme_inter_autres_operateurs_onnet_hc") @db.Decimal(15, 2)
  sommeInterAutresOperateursOnnetHP    Decimal?  @default(0) @map("somme_inter_autres_operateurs_onnet_hp") @db.Decimal(15, 2)
  nombreAutresOperateurs       Int?      @map("nombre_autres_operateurs")
  taMoyenBaseOffnetHC          Decimal?  @default(0) @map("ta_moyen_base_offnet_hc") @db.Decimal(10, 2)
  taMoyenBaseOffnetHP          Decimal?  @default(0) @map("ta_moyen_base_offnet_hp") @db.Decimal(10, 2)
  taMoyenBaseOnnetHC           Decimal?  @default(0) @map("ta_moyen_base_onnet_hc") @db.Decimal(10, 2)
  taMoyenBaseOnnetHP           Decimal?  @default(0) @map("ta_moyen_base_onnet_hp") @db.Decimal(10, 2)
  taMoyenInterOffnetHC         Decimal?  @default(0) @map("ta_moyen_inter_offnet_hc") @db.Decimal(10, 2)
  taMoyenInterOffnetHP         Decimal?  @default(0) @map("ta_moyen_inter_offnet_hp") @db.Decimal(10, 2)
  taMoyenInterOnnetHC          Decimal?  @default(0) @map("ta_moyen_inter_onnet_hc") @db.Decimal(10, 2)
  taMoyenInterOnnetHP          Decimal?  @default(0) @map("ta_moyen_inter_onnet_hp") @db.Decimal(10, 2)
  prixOnNet                    Decimal?  @map("prix_on_net") @db.Decimal(10, 2)
  prixOffNet                   Decimal?  @map("prix_off_net") @db.Decimal(10, 2)
  
  // Nouveaux champs pour les revenus moyens
  revenuMoyenOnNet             Decimal?  @default(0) @map("revenu_moyen_on_net") @db.Decimal(10, 2)
  revenuMoyenOffNet            Decimal?  @default(0) @map("revenu_moyen_off_net") @db.Decimal(10, 2)
  
  // Nouveaux champs pour les calculs de sommes
  sommeFraisSouscription       Decimal?  @default(0) @map("somme_frais_souscription") @db.Decimal(15, 2)
  sommeTraficGratuit           Decimal?  @default(0) @map("somme_trafic_gratuit") @db.Decimal(15, 2)
  sommeTraficOption            Decimal?  @default(0) @map("somme_trafic_option") @db.Decimal(15, 2)
  
  effetClub                    Decimal?  @map("effet_club") @db.Decimal(10, 2)
  
  // 8 effets club spécifiques pour chaque combinaison de tarifs (MÉTHODE CLASSIQUE - prix)
  effetClubBaseOffnetHC        Decimal?  @map("effet_club_base_offnet_hc") @db.Decimal(10, 2)
  effetClubBaseOffnetHP        Decimal?  @map("effet_club_base_offnet_hp") @db.Decimal(10, 2)
  effetClubBaseOnnetHC         Decimal?  @map("effet_club_base_onnet_hc") @db.Decimal(10, 2)
  effetClubBaseOnnetHP         Decimal?  @map("effet_club_base_onnet_hp") @db.Decimal(10, 2)
  effetClubInterOffnetHC       Decimal?  @map("effet_club_inter_offnet_hc") @db.Decimal(10, 2)
  effetClubInterOffnetHP       Decimal?  @map("effet_club_inter_offnet_hp") @db.Decimal(10, 2)
  effetClubInterOnnetHC        Decimal?  @map("effet_club_inter_onnet_hc") @db.Decimal(10, 2)
  effetClubInterOnnetHP        Decimal?  @map("effet_club_inter_onnet_hp") @db.Decimal(10, 2)
  
  // 8 effets club spécifiques SELON REVENUS MOYENS (NOUVELLE MÉTHODE)
  effetClubRevenuBaseOffnetHC    Decimal?  @map("effet_club_revenu_base_offnet_hc") @db.Decimal(10, 2)
  effetClubRevenuBaseOffnetHP    Decimal?  @map("effet_club_revenu_base_offnet_hp") @db.Decimal(10, 2)
  effetClubRevenuBaseOnnetHC     Decimal?  @map("effet_club_revenu_base_onnet_hc") @db.Decimal(10, 2)
  effetClubRevenuBaseOnnetHP     Decimal?  @map("effet_club_revenu_base_onnet_hp") @db.Decimal(10, 2)
  effetClubRevenuInterOffnetHC   Decimal?  @map("effet_club_revenu_inter_offnet_hc") @db.Decimal(10, 2)
  effetClubRevenuInterOffnetHP   Decimal?  @map("effet_club_revenu_inter_offnet_hp") @db.Decimal(10, 2)
  effetClubRevenuInterOnnetHC    Decimal?  @map("effet_club_revenu_inter_onnet_hc") @db.Decimal(10, 2)
  effetClubRevenuInterOnnetHP    Decimal?  @map("effet_club_revenu_inter_onnet_hp") @db.Decimal(10, 2)
  
  // Effet club général selon revenus moyens
  effetClubRevenus             Decimal?  @map("effet_club_revenus") @db.Decimal(10, 2)
  
  // 8 résultats spécifiques (MÉTHODE CLASSIQUE)
  resultatBaseOffnetHC         String?   @map("resultat_base_offnet_hc") @db.VarChar(100)
  resultatBaseOffnetHP         String?   @map("resultat_base_offnet_hp") @db.VarChar(100)
  resultatBaseOnnetHC          String?   @map("resultat_base_onnet_hc") @db.VarChar(100)
  resultatBaseOnnetHP          String?   @map("resultat_base_onnet_hp") @db.VarChar(100)
  resultatInterOffnetHC        String?   @map("resultat_inter_offnet_hc") @db.VarChar(100)
  resultatInterOffnetHP        String?   @map("resultat_inter_offnet_hp") @db.VarChar(100)
  resultatInterOnnetHC         String?   @map("resultat_inter_onnet_hc") @db.VarChar(100)
  resultatInterOnnetHP         String?   @map("resultat_inter_onnet_hp") @db.VarChar(100)
  
  // 8 résultats spécifiques SELON REVENUS MOYENS (NOUVELLE MÉTHODE)
  resultatRevenuBaseOffnetHC   String?   @map("resultat_revenu_base_offnet_hc") @db.VarChar(100)
  resultatRevenuBaseOffnetHP   String?   @map("resultat_revenu_base_offnet_hp") @db.VarChar(100)
  resultatRevenuBaseOnnetHC    String?   @map("resultat_revenu_base_onnet_hc") @db.VarChar(100)
  resultatRevenuBaseOnnetHP    String?   @map("resultat_revenu_base_onnet_hp") @db.VarChar(100)
  resultatRevenuInterOffnetHC  String?   @map("resultat_revenu_inter_offnet_hc") @db.VarChar(100)
  resultatRevenuInterOffnetHP  String?   @map("resultat_revenu_inter_offnet_hp") @db.VarChar(100)
  resultatRevenuInterOnnetHC   String?   @map("resultat_revenu_inter_onnet_hc") @db.VarChar(100)
  resultatRevenuInterOnnetHP   String?   @map("resultat_revenu_inter_onnet_hp") @db.VarChar(100)
  
  // Résultat général selon revenus moyens
  resultatRevenus              String?   @map("resultat_revenus") @db.VarChar(100)
  
  // 8 booléens pour indiquer si c'est un effet club (MÉTHODE CLASSIQUE)
  isEffetClubBaseOffnetHC      Boolean   @default(false) @map("is_effet_club_base_offnet_hc")
  isEffetClubBaseOffnetHP      Boolean   @default(false) @map("is_effet_club_base_offnet_hp")
  isEffetClubBaseOnnetHC       Boolean   @default(false) @map("is_effet_club_base_onnet_hc")
  isEffetClubBaseOnnetHP       Boolean   @default(false) @map("is_effet_club_base_onnet_hp")
  isEffetClubInterOffnetHC     Boolean   @default(false) @map("is_effet_club_inter_offnet_hc")
  isEffetClubInterOffnetHP     Boolean   @default(false) @map("is_effet_club_inter_offnet_hp")
  isEffetClubInterOnnetHC      Boolean   @default(false) @map("is_effet_club_inter_onnet_hc")
  isEffetClubInterOnnetHP      Boolean   @default(false) @map("is_effet_club_inter_onnet_hp")
  
  // 8 booléens pour indiquer si c'est un effet club SELON REVENUS MOYENS (NOUVELLE MÉTHODE)
  isEffetClubRevenuBaseOffnetHC    Boolean   @default(false) @map("is_effet_club_revenu_base_offnet_hc")
  isEffetClubRevenuBaseOffnetHP    Boolean   @default(false) @map("is_effet_club_revenu_base_offnet_hp")
  isEffetClubRevenuBaseOnnetHC     Boolean   @default(false) @map("is_effet_club_revenu_base_onnet_hc")
  isEffetClubRevenuBaseOnnetHP     Boolean   @default(false) @map("is_effet_club_revenu_base_onnet_hp")
  isEffetClubRevenuInterOffnetHC   Boolean   @default(false) @map("is_effet_club_revenu_inter_offnet_hc")
  isEffetClubRevenuInterOffnetHP   Boolean   @default(false) @map("is_effet_club_revenu_inter_offnet_hp")
  isEffetClubRevenuInterOnnetHC    Boolean   @default(false) @map("is_effet_club_revenu_inter_onnet_hc")
  isEffetClubRevenuInterOnnetHP    Boolean   @default(false) @map("is_effet_club_revenu_inter_onnet_hp")
  
  isEffetClub                  Boolean   @default(false) @map("is_effet_club")
  // Booléen général selon revenus moyens
  isEffetClubRevenus           Boolean   @default(false) @map("is_effet_club_revenus")
  resultat                     String?   @map("resultat") @db.VarChar(100)
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  operateur         Operateur @relation(fields: [operateurId], references: [id], onDelete: Cascade)
  avantages         OffreAvantage[]
  services          OffreService[]
  caracteristiques  Caracteristique[]
  consommationsMoyennes OffreConsommationMoyenne[]
  options           Option[]

  @@unique([operateurId, nom], name: "unique_offre_par_operateur")
  @@index([id])
  @@index([operateurId])
  @@index([nom])
  @@index([typeOffre])
  @@index([statut])
  @@index([dateDebutValidite])
  @@index([dateFinValidite])
  @@map("offres")
}

model TarifInterconnexion {
  id          Int       @id @default(autoincrement()) @map("id")
  operateurId Int       @map("operateur_id")
  annee       Int       @map("annee")
  tarifOffNetHeureCreuse    Decimal   @map("tarif_off_net_heure_creuse") @db.Decimal(10, 2)
  tarifOffNetHeurePleine    Decimal   @map("tarif_off_net_heure_pleine") @db.Decimal(10, 2)
  tarifOnNetHeureCreuse     Decimal   @map("tarif_on_net_heure_creuse") @db.Decimal(10, 2)
  tarifOnNetHeurePleine     Decimal   @map("tarif_on_net_heure_pleine") @db.Decimal(10, 2)
  typeTarif   String    @default("Standard") @map("type_tarif") @db.VarChar(100)
  description String?   @map("description") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relations
  operateur   Operateur @relation(fields: [operateurId], references: [id], onDelete: Cascade)
  services    TarifInterconnexionService[]

  // Contrainte unique : un opérateur ne peut avoir que deux tarifs par année (avec types différents)
  @@unique([operateurId, annee, typeTarif], name: "unique_tarif_operateur_annee_type")
  @@index([id])
  @@index([operateurId])
  @@index([annee])
  @@index([typeTarif])
  @@map("tarifs_interconnexion")
}

model TarifInterconnexionService {
  id                    Int                 @id @default(autoincrement()) @map("id")
  tarifInterconnexionId Int                 @map("tarif_interconnexion_id")
  serviceId             Int                 @map("service_id")
  createdAt             DateTime            @default(now()) @map("created_at")

  // Relations
  tarifInterconnexion   TarifInterconnexion @relation(fields: [tarifInterconnexionId], references: [id], onDelete: Cascade)
  service               Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tarifInterconnexionId, serviceId], name: "unique_tarif_service")
  @@index([tarifInterconnexionId])
  @@index([serviceId])
  @@map("tarif_interconnexion_services")
}

enum UserRole {
  UTILISATEUR
  SUPER_ADMIN
}

model Avantage {
  id        Int      @id @default(autoincrement()) @map("id")
  nom       String   @map("nom") @db.VarChar(255)
  valeur    Decimal  @map("valeur") @db.Decimal(10, 2)
  isGratuit Boolean  @default(false) @map("is_gratuit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations Many-to-Many avec les offres et options
  offres    OffreAvantage[]
  options   OptionAvantage[]

  @@index([nom])
  @@map("avantages")
}

model OffreAvantage {
  id          Int      @id @default(autoincrement()) @map("id")
  offreId     Int      @map("offre_id")
  avantageId  Int      @map("avantage_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  offre       Offre    @relation(fields: [offreId], references: [id], onDelete: Cascade)
  avantage    Avantage @relation(fields: [avantageId], references: [id], onDelete: Cascade)

  @@unique([offreId, avantageId], name: "unique_offre_avantage")
  @@index([offreId])
  @@index([avantageId])
  @@map("offre_avantages")
}

model OffreService {
  id        Int      @id @default(autoincrement()) @map("id")
  offreId   Int      @map("offre_id")
  serviceId Int      @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  offre     Offre   @relation(fields: [offreId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([offreId, serviceId], name: "unique_offre_service")
  @@index([offreId])
  @@index([serviceId])
  @@map("offre_services")
}

model TypeOperateur {
  id          Int      @id @default(autoincrement()) @map("id")
  nom         String   @unique @map("nom") @db.VarChar(191)
  description String?  @map("description") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([nom])
  @@map("types_operateur")
}

model Trafic {
  id             Int      @id @default(autoincrement()) @map("id")
  operateurId    Int      @map("operateur_id")
  annee          Int      @map("annee")
  typeTrafic     String   @map("type_trafic") @db.VarChar(100)
  volume         Decimal  @map("volume") @db.Decimal(18, 4)
  autreOperateur Json?    @map("autre_operateur") @db.Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  operateur      Operateur @relation(fields: [operateurId], references: [id], onDelete: Cascade)
  services       TraficService[]
  autresOperateurs TraficAutreOperateur[]

  @@index([id])
  @@index([operateurId])
  @@index([annee])
  @@map("trafics")
}

model TraficService {
  id        Int     @id @default(autoincrement()) @map("id")
  traficId  Int     @map("trafic_id")
  serviceId Int     @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  trafic    Trafic  @relation(fields: [traficId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([traficId, serviceId], name: "unique_trafic_service")
  @@index([traficId])
  @@index([serviceId])
  @@map("trafic_services")
}

