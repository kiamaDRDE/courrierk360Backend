model PartMarche {
  id                       Int      @id @default(autoincrement()) @map("id")
  operateurId              Int      @map("operateur_id")
  annee                    Int      @map("annee")
  partMarcheTrafic         Decimal? @map("part_marche_trafic") @db.Decimal(5, 2)
  partMarcheChiffreAffaire Decimal? @map("part_marche_chiffre_affaire") @db.Decimal(5, 2)
  partMarcheAbonnes        Decimal? @map("part_marche_abonnes") @db.Decimal(5, 2)
  
  // Nouveaux champs pour les sommes
  sommeTrafic              Decimal? @map("somme_trafic") @db.Decimal(15, 2)
  sommeAbonnement          Decimal? @map("somme_abonnement") @db.Decimal(15, 2)
  sommeChiffreAffaire      Decimal? @map("somme_chiffre_affaire") @db.Decimal(18, 2)
  
  // Nouveaux champs pour les volumes/données spécifiques
  volumeTrafic             Decimal? @map("volume_trafic") @db.Decimal(15, 2)
  nombreAbonne             Int?     @map("nombre_abonne")
  chiffreAffaire           Decimal? @map("chiffre_affaire") @db.Decimal(18, 2)
  
  // Champs IHH calculés pour chaque métrique
  ihhTrafic                Decimal? @map("ihh_trafic") @db.Decimal(10, 4)
  ihhAbonne                Decimal? @map("ihh_abonne") @db.Decimal(10, 4)
  ihhChiffreAffaire        Decimal? @map("ihh_chiffre_affaire") @db.Decimal(10, 4)
  
  // Champs booléens pour indiquer si le marché est concentré
  isConcentreTrafic        Boolean  @default(false) @map("is_concentre_trafic")
  isConcentreAbonne        Boolean  @default(false) @map("is_concentre_abonne")
  isConcentreChiffreAffaire Boolean  @default(false) @map("is_concentre_chiffre_affaire")
  
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  operateur Operateur @relation(fields: [operateurId], references: [id], onDelete: Cascade)

  // Un opérateur ne peut avoir qu'une part de marché par année
  @@unique([operateurId, annee], name: "unique_operateur_annee_part_marche")
  @@index([operateurId])
  @@index([annee])
  @@map("parts_marche")
}

